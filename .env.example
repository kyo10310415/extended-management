# Server Configuration
PORT=3000
NODE_ENV=development

# SSO Authentication (WannaV Dashboard)
JWT_SECRET=your-shared-secret-key-here
DASHBOARD_URL=https://wannav-main.onrender.com

# Notion API
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=88e474e5400f44998fa04d982b1c8ef7

# Google Sheets API
GOOGLE_SHEETS_ID=1m7P2nsX-M9BGP2RHIj3CjAZiDPs2K9gu1Y_md7xiazQ
TUTOR_WEBHOOK_SHEET_ID=13rHnYHavM6Mm7JRC3n88X2pTCoAlCZOXMkapDq7uwNs
# Option 1: Use service account (recommended for production)
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json
# Option 2: Use API key (simpler but less secure)
# GOOGLE_API_KEY=your_google_api_key_here

# PostgreSQL Database (Render will provide this)
DATABASE_URL=postgresql://user:password@host:5432/database

# Slack Webhook for suspension end notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Slack User Group ID for mentions (optional, e.g., tutors group)
# To get Group ID: Slack > People & user groups > Click on group > Copy Group ID from URL
# Format: S01234ABCDE
SLACK_MENTION_GROUP_ID=S01234ABCDE
# Optional: Slack user group ID for @tutors mention (e.g., S07XXXXXXXX)
# If not set, will use plain text "@tutors" instead of actual mention
SLACK_MENTION_GROUP_ID=
